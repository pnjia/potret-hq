{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cameras.schema.json",
  "title": "Katalog kamera (skin)",
  "description": "Entitas Camera (glosarium). Skin = overlay bodi + LUT + suara shutter. Path aset relatif terhadap app/. Kamera gratis wajib punya overlay, layout, lut, dan shelfImage; kamera terkunci yang tampil cukup shelfImage (dicek scripts/cek-hq.mjs).",
  "type": "object",
  "required": [
    "meta",
    "cameras"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "verifiedAt",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "verifiedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "lut",
          "overlay",
          "shutterSound",
          "sku",
          "isFree",
          "isLocked",
          "example",
          "shelfImage",
          "layout",
          "effectName"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "lut": {
            "type": "string",
            "minLength": 1
          },
          "overlay": {
            "type": "string",
            "minLength": 1
          },
          "shutterSound": {
            "type": "string",
            "minLength": 1
          },
          "sku": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null selama toko belum dibuka (K-007)"
          },
          "isFree": {
            "type": "boolean"
          },
          "isLocked": {
            "type": "boolean",
            "description": "true = 'terkunci, segera hadir'; ketukan dicatat sebagai Event"
          },
          "example": {
            "type": "boolean",
            "description": "true = entri contoh, bukan data final"
          },
          "isListed": {
            "type": "boolean",
            "description": "false = belum tampil di etalase (mis. kamera toko saat MVP, K-034). Bila tidak ada, dianggap true"
          },
          "shelfImage": {
            "type": "string",
            "pattern": "^assets/cameras/[a-z0-9-]+/shelf\\.png$",
            "description": "Ilustrasi tampak depan untuk etalase kamera (CameraShelf), tanpa merek (K-034)"
          },
          "layout": {
            "type": "string",
            "pattern": "^assets/cameras/[a-z0-9-]+/layout\\.json$",
            "description": "Posisi jendela bidik, tombol, pita regang, gaya kontrol, dan kekuatan butir (K-044); kanvas acuan 390x844"
          },
          "effectName": {
            "type": [
              "string",
              "null"
            ],
            "description": "Catatan efek di etalase, mis. 'CCD hangat'; null sampai kamera itu dirancang lengkap"
          }
        }
      }
    }
  }
}
