{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "categories.schema.json",
  "title": "Taksonomi kategori Temuan",
  "description": "Kategori otomatis (K-020) dan pemetaan label ML Kit Image Labeling ke kategori. Dipakai Finding.category, Landmark.category, misi, dan lencana koleksi kategori.",
  "type": "object",
  "required": ["meta", "categories"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["verifiedAt", "source", "confidenceThreshold", "rule", "note"],
      "additionalProperties": false,
      "properties": {
        "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string", "minLength": 1 },
        "confidenceThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "tieBreakOrder", "missionEligible", "mlkitLabels"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
          "name": { "type": "string", "minLength": 1, "description": "Nama tampilan Bahasa Indonesia" },
          "tieBreakOrder": { "type": "integer", "minimum": 1, "description": "Pemecah seri: angka kecil menang" },
          "shareLabel": { "type": "string", "minLength": 1, "description": "Julukan di kartu share Label Pemburu, dipilih pengguna (K-033, K-038)" },
        "missionEligible": { "type": "boolean", "description": "Boleh dipakai misi mingguan dan lencana (K-009)" },
          "mlkitLabels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "index"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string", "minLength": 1, "description": "Teks label persis seperti di label map ML Kit" },
                "index": { "type": "integer", "minimum": 0 },
                "weak": { "type": "boolean", "description": "Label pendukung; hanya dipakai bila tidak ada label terpetakan lain" }
              }
            }
          }
        }
      }
    }
  }
}
