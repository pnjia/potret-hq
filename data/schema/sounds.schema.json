{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sounds.schema.json",
  "title": "Catatan lisensi suara",
  "description": "Setiap file suara di aplikasi (buka halaman, shutter) tercatat di sini beserta sumber dan lisensinya (K-024). Hanya rekaman sendiri, Freesound CC0, atau Pixabay yang diolah di aplikasi.",
  "type": "object",
  "required": ["meta", "sounds"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["verifiedAt", "note"],
      "additionalProperties": false,
      "properties": {
        "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "use", "source", "license", "url", "author", "addedAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "file": { "type": "string", "minLength": 1, "description": "Path relatif terhadap app/" },
          "use": { "type": "string", "enum": ["page-turn", "shutter", "ui"] },
          "source": { "type": "string", "enum": ["foley", "freesound", "pixabay"] },
          "license": { "type": "string", "enum": ["own", "CC0-1.0", "Pixabay-Content-License"] },
          "url": { "type": ["string", "null"], "description": "Halaman sumber; null untuk rekaman sendiri" },
          "author": { "type": "string", "minLength": 1 },
          "addedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
